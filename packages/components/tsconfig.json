{
  "extends": "./tsconfig/tsconfig.lumina.json",
  "compilerOptions": {
    "noImplicitAny": false,
    "noImplicitReturns": false,
    "plugins": [
      {
        "name": "typescript-strict-plugin"
      }
    ],
    "types": ["@arcgis/core/interfaces.d.ts", "@arcgis/lumina", "@arcgis/map-components", "@esri/calcite-components"]
  },
  "include": ["src", "**/*.config.js", "**/*.config.ts"],
  "exclude": ["src/tests/**/*"],
}
