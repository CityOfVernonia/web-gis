{
  "name": "@vernonia/components",
  "version": "0.0.0.beta.1",
  "description": "City of Vernonia web components.",
  "homepage": "https://github.com/CityOfVernonia/web-gis",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CityOfVernonia/web-gis.git",
    "directory": "packages/components"
  },
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./loader": "./dist/loader.js",
    "./package.json": "./package.json",
    "./components/*/customElement": "./dist/components/*/customElement.js",
    "./components/*": "./dist/components/*/index.js",
    "./types/*": "./dist/types/*.d.ts",
    "./docs/*": "./dist/docs/*",
    "./dist/loader": "./dist/loader.js",
    "./dist/components": "./dist/index.js",
    "./dist/components/*": "./dist/components/*/index.js",
    "./main.css": "./dist/cdn/main.css"
  },
  "files": [
    "dist/"
  ],
  "scripts": {
    "build": "rimraf dist && vite build --mode production",
    "dev": "vite --mode development",
    "lint": "eslint --fix",
    "test": "npm run lint && vitest run"
  },
  "dependencies": {
    "@arcgis/core": "^4.34.8",
    "@arcgis/lumina": "^4.34.9",
    "@arcgis/map-components": "^4.34.9",
    "@esri/calcite-components": "^3.3.3"
  },
  "peerDependencies": {
    
  },
  "css.customData": [
    "dist/docs/vscode.css-custom-data.json"
  ],
  "customElements": "dist/docs/api.json",
  "html.customData": [
    "dist/docs/vscode.html-custom-data.json"
  ],
  "web-types": "dist/docs/web-types.json"
}